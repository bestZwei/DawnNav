# ===== 数据库配置 =====
# 唯一数据源为 SQLite（零配置）：数据文件路径由 SQLITE_PATH 控制
# （默认 /app/data/nav.db，本地开发为 ./data/nav.db），
# 文件或目录缺失时自动创建，首次启动自动建表并写入种子数据。
SQLITE_PATH=

# 会话签名密钥（HMAC）：生产环境务必设置为随机长字符串，未设置时回退 NEXTAUTH_SECRET
SESSION_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=
# 工作区预览参数开关：设为 true 时可用 ?__workspace=<slug> 模拟子域名访问（开发模式默认开启，生产忽略）
ENABLE_WORKSPACE_PREVIEW=

# 初始管理员账号（仅首次 seed 生效；已运行实例上后补设置也会在启动时对齐创建）：
# 公网部署务必设置 ADMIN_PASSWORD
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 构建版本信息（Docker 构建时注入，本地开发可留空）
NEXT_PUBLIC_APP_VERSION=
NEXT_PUBLIC_GIT_SHA=

# 更新检查 API 基地址（默认 https://api.github.com）：
# 服务器无法直连 api.github.com 时，可指向原样透传 GitHub API 响应的反代/镜像地址
UPDATE_CHECK_BASE_URL=

# 会话密钥文件路径（entrypoint 兜底密钥持久化位置；
# Docker 镜像默认 /app/.session-data/.session-secret，位于 compose 挂载卷内可持久化）
SESSION_SECRET_FILE=
